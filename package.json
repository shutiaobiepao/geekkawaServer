{
  "name": "geekkawa-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:web-static": "node scripts/sync-web-static.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "sync:web-static:release": "node scripts/sync-web-static.mjs --build-home --hash-home-assets --build-web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.1",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
